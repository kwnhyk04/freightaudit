# Settings of the Playwright run, laid over the shell's environment by playwright.config.ts and e2e/prepare.ts, so
# nothing in the shell or CI can point the run at dev data. Its own database, Redis prefix and bucket; every model role
# on the recorded-fixture provider, so no real model is called. Keys and secrets here are test placeholders.
HOST=127.0.0.1
LOG_LEVEL=warn
API_PORT=4000
WORKER_PORT=4001
DATABASE_URL=postgres://freightaudit:freightaudit@localhost:5432/freightaudit_e2e
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=freightaudit-e2e
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=freightaudit
S3_SECRET_KEY=freightaudit
S3_BUCKET=freightaudit-e2e
TENANT_ID=5fb9220d-9b0f-4d32-a248-6492457c3890
API_KEYS=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
API_KEY=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
API_URL=http://127.0.0.1:4000
SESSION_SECRET=ssssssssssssssssssssssssssssssssssssssss
# The reviewer's password in this run; playwright.config.ts hashes it into DEMO_PASSWORD_HASH.
E2E_PASSWORD=e2e-reviewer-password
RATE_LIMIT_PER_MIN=100000
UPLOAD_RATE_LIMIT_PER_MIN=1000
OTEL_SDK_DISABLED=true
AI_ENABLED=true
LLM_PRIMARY_BASE_URL=http://127.0.0.1:4011
LLM_TEXT_BASE_URL=http://127.0.0.1:4011
LLM_FALLBACK_BASE_URL=http://127.0.0.1:4011
GEMINI_API_KEY=fixture
GROQ_API_KEY=fixture
LLM_PRIMARY_RPM=100000
LLM_PRIMARY_TPM=1000000000
LLM_TEXT_RPM=100000
LLM_TEXT_TPM=1000000000
LLM_FALLBACK_RPM=100000
LLM_FALLBACK_TPM=1000000000
DAILY_AI_TOKEN_BUDGET=1000000000
MOCK_TMS_URL=http://127.0.0.1:4011
