{
  "name": "@freightaudit/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "e2e": "node e2e/prepare.ts && playwright test --project=setup --project=main --project=public --project=lockout",
    "e2e:screenshots": "node e2e/prepare.ts && playwright test --project=screenshots",
    "hash-password": "node scripts/hash-password.ts",
    "demo:export": "node --env-file=../../.env scripts/export-demo.ts"
  },
  "dependencies": {
    "@freightaudit/config": "workspace:*",
    "@freightaudit/contracts": "workspace:*",
    "@freightaudit/domain": "workspace:*",
    "next": "^16.4.0",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "catalog:",
    "jest": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:"
  }
}
