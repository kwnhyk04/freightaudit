{
  "name": "freightaudit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:int": "turbo run build --filter=./packages/* --output-logs=errors-only && node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --selectProjects integration contract",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "turbo run db:migrate --",
    "db:seed": "turbo run db:seed --",
    "db:reset": "turbo run db:reset",
    "extract:resume": "turbo run extract:resume",
    "fixtures": "turbo run fixtures --",
    "codegen": "turbo run codegen",
    "eval": "turbo run eval --",
    "contracts:check": "turbo run contracts:check",
    "contracts:breaking": "turbo run contracts:breaking"
  },
  "devDependencies": {
    "@freightaudit/config": "workspace:*",
    "jest": "catalog:",
    "turbo": "^2.11.7"
  }
}
