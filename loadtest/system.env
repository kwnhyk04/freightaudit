# Part 1 of the load test (README, Load test): settings for the api and both workers, loaded after .env with a second
# --env-file. They point every model role at the recorded-fixture provider (pnpm --filter @freightaudit/llm
# fixture-models), so the keys below are not secrets: they only reach that local server.
# Its own Redis prefix keeps this run's queues and its day's token count apart from dev and part 2.
REDIS_PREFIX=freightaudit-loadtest
# One k6 client sends the whole load; the per-key limits would hold it to 10 uploads a minute.
RATE_LIMIT_PER_MIN=1000000
UPLOAD_RATE_LIMIT_PER_MIN=1000000
AI_ENABLED=true
LLM_PRIMARY_BASE_URL=http://127.0.0.1:4011
LLM_TEXT_BASE_URL=http://127.0.0.1:4011
LLM_FALLBACK_BASE_URL=http://127.0.0.1:4011
GEMINI_API_KEY=fixture-models-not-a-key
GROQ_API_KEY=fixture-models-not-a-key
# The fixture server has no limits; buckets this large never wait.
LLM_PRIMARY_RPM=100000
LLM_PRIMARY_TPM=1000000000
LLM_TEXT_RPM=100000
LLM_TEXT_TPM=1000000000
LLM_FALLBACK_RPM=100000
LLM_FALLBACK_TPM=1000000000
# About 1,070 uploads at the recorded 1,300 to 1,600 tokens each pass the default 1,000,000 a day, which would park
# the rest until midnight.
DAILY_AI_TOKEN_BUDGET=1000000000
# The fixture server answers the TMS sync with an empty page.
MOCK_TMS_URL=http://127.0.0.1:4011
