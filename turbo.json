{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.js"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "codegen": {
      "cache": false
    },
    "db:migrate": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "db:seed": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "db:reset": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV"
      ]
    },
    "claude:resume": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "extract:resume": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "fixtures": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "eval": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "DOCKER_*",
        "TESTCONTAINERS_*",
        "HOME",
        "USERPROFILE",
        "GEMINI_API_KEY",
        "GROQ_API_KEY",
        "CI"
      ]
    },
    "contracts:check": {
      "cache": false
    },
    "contracts:breaking": {
      "cache": false,
      "passThroughEnv": [
        "OASDIFF_BASE_REF"
      ]
    }
  }
}
