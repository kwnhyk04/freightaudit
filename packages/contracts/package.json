{
  "name": "@freightaudit/contracts",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./graphql": "./dist/generated/graphql-client/graphql.js",
    "./hold": "./dist/hold.js",
    "./limits": "./dist/limits.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "codegen": "node scripts/codegen-openapi.ts && graphql-codegen",
    "contracts:breaking": "node scripts/breaking.ts",
    "contracts:check": "node scripts/check-generated.ts",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.14.2",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@freightaudit/config": "workspace:*",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@graphql-eslint/eslint-plugin": "^4.4.1",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "openapi-typescript": "^7.13.0",
    "typescript": "catalog:"
  }
}
