{
  "name": "@freightaudit/pipeline",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:reset": "node --env-file-if-exists=../../.env scripts/reset.ts",
    "extract:resume": "node --env-file-if-exists=../../.env scripts/resume-extract.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@freightaudit/db": "workspace:*",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "ioredis": "catalog:"
  },
  "devDependencies": {
    "@freightaudit/config": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "typescript": "catalog:"
  }
}
