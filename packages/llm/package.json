{
  "name": "@freightaudit/llm",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "claude:resume": "node --env-file-if-exists=../../.env scripts/resume-claude.ts",
    "fixture-models":"node scripts/fixture-models.ts",
    "record:anthropic": "node --env-file-if-exists=../../.env scripts/record-anthropic-errors.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@freightaudit/contracts": "workspace:*",
    "@freightaudit/db": "workspace:*",
    "@freightaudit/domain": "workspace:*",
    "@google/genai": "^2.31.0",
    "@napi-rs/canvas": "^1.0.13",
    "@opentelemetry/api": "catalog:",
    "ioredis": "catalog:",
    "pdf-lib": "catalog:",
    "pdfjs-dist": "^6.4.299",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@freightaudit/config": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "typescript": "catalog:"
  }
}
