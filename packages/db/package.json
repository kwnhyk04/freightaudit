{
  "name": "@freightaudit/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./migrate": "./dist/migrate.js",
    "./testing": "./dist/testing.js",
    "./scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env scripts/seed.ts",
    "backfill:rate-card-versions": "node --env-file-if-exists=../../.env scripts/backfill-rate-card-versions.ts"
  },
  "dependencies": {
    "@freightaudit/config": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@freightaudit/domain": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
