# Copy to .env; apps load it in dev. Values match infra/docker-compose.yml (dev-only credentials).
# Each service validates the settings it reads at startup and refuses to start if one is missing or invalid.

# Shared by the Node services.
HOST=localhost
LOG_LEVEL=info

# api. API_KEYS holds comma-separated keys of at least 32 characters for the X-API-Key header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_PORT=4000
API_KEYS=
# Also read by pnpm db:migrate, db:seed and db:reset. pnpm test:int reads no .env: it starts its own containers.
DATABASE_URL=postgres://freightaudit:freightaudit@localhost:5432/freightaudit
REDIS_URL=redis://localhost:6379
# Prefix of every Redis key: queues, rate limits, AI counters.
REDIS_PREFIX=freightaudit
# PDFs, stored by content hash; the bucket is created on first upload.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=freightaudit
S3_SECRET_KEY=freightaudit
S3_BUCKET=invoices
# One tenant per deployment for now; this is the tenant pnpm db:seed creates.
TENANT_ID=5fb9220d-9b0f-4d32-a248-6492457c3890
# Uploads get 503 with Retry-After while more extract jobs than this are waiting.
EXTRACT_HIGH_WATER=5000

# worker and mock-tms ports. web listens on 3000; pass --port to its dev script to change it.
WORKER_PORT=4001
MOCK_TMS_PORT=4010

# worker. AI_ENABLED=false stops every model call and needs no key; extract jobs wait instead (the default).
AI_ENABLED=false
# Model roles: provider (gemini, groq, mistral, openrouter, nvidia or ollama), model, base URL (empty means the
# provider's default) and the model's requests and tokens per minute, shared by all workers. The primary reads scanned
# pages as images, the text model reads pages with a text layer, and the fallback, on another provider than the
# primary, takes over after a 429 or output that stays invalid. Models pinned on 2026-10-15 from each key's model list,
# limits from that day's free tiers; every model needs an entry in packages/llm/prices.json.
LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_MODEL=gemini-3.5-flash-lite
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_RPM=15
LLM_PRIMARY_TPM=250000
LLM_TEXT_PROVIDER=groq
LLM_TEXT_MODEL=openai/gpt-oss-120b
LLM_TEXT_BASE_URL=
LLM_TEXT_RPM=30
LLM_TEXT_TPM=8000
# The fallback shares Groq with the text model and reads at most 3 page images a request. Mistral works the same way
# should its account ever allow requests: mistral, mistral-small-2603, 60 requests and 20000 tokens a minute.
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_RPM=30
LLM_FALLBACK_TPM=8000
# A page whose text layer has fewer non-space characters than this goes to the primary as a JPEG.
LLM_TEXT_MIN_CHARS=100
# One key per provider account, required while AI_ENABLED=true for each provider a role uses. Free tiers may train on
# prompts, so only synthetic data goes through them. Gemini keys (AQ. format) travel only in the x-goog-api-key header.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# Extract jobs wait for the next UTC day once this many tokens are spent.
DAILY_AI_TOKEN_BUDGET=1000000
# How long a worker owns a job before another may recover it (ms); stalled checks run every half of it.
JOB_LOCK_MS=60000
MOCK_TMS_URL=http://localhost:4010

# pnpm db:reset (dev only) refuses to run with NODE_ENV=production; set that on a machine whose database holds real data.
# NODE_ENV=production

# mock-tms fault injection: share of /shipments requests that fail with 500, and delay added to each.
FAULT_RATE=0
LATENCY_MS=0

# Not read yet: tracing arrives in step 8.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Host ports for infra/docker-compose.yml, read with --env-file .env. Keep the URLs above in sync.
# infra/toxiproxy.json proxies mock-tms on port 4010.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
JAEGER_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
TOXIPROXY_PORT=8474
TOXIPROXY_POSTGRES_PORT=15432
TOXIPROXY_REDIS_PORT=16379
TOXIPROXY_MOCK_TMS_PORT=14010
