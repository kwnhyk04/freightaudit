# The public demo's backend on this PC (pnpm demo:up), read from .env.prod, which git and Docker builds ignore.
# pnpm demo:init copies this file to .env.prod and fills API_KEYS, POSTGRES_PASSWORD and MINIO_ROOT_PASSWORD with
# random values. Then set GEMINI_API_KEY, GROQ_API_KEY and TS_AUTHKEY in an editor. docs/deploy.md lists every value,
# where it lives and how to rotate it. Never put a paid key here: the demo runs on free tiers only.

# The CI-built images (release.yml); pin a release with sha-<7 hex>.
IMAGE_REPO=ghcr.io/kwnhyk04
IMAGE_TAG=latest
# The tenant the seed creates.
TENANT_ID=5fb9220d-9b0f-4d32-a248-6492457c3890

# Random, from pnpm demo:init. The web's API_KEY on Vercel is one of these keys.
API_KEYS=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=freightaudit
MINIO_ROOT_PASSWORD=

# The worker's models: free-tier keys for the demo, ideally new ones (a Google AI Studio project without billing).
AI_ENABLED=true
GEMINI_API_KEY=
GROQ_API_KEY=
# Tokens a UTC day across all models; the Groq account is shared with other projects and CI.
DAILY_AI_TOKEN_BUDGET=100000
# Claude Haiku first (docs/deploy.md): its key, its model and the last UTC day it reads first; empty keeps the free chain.
ANTHROPIC_API_KEY=
LLM_CLAUDE_MODEL=
LLM_CLAUDE_FIRST_UNTIL=
DAILY_CLAUDE_TOKEN_BUDGET=1400000

# Tailscale: a one-off auth key tagged tag:freightaudit, needed only until the node first logs in; then delete it.
TS_AUTHKEY=
# The first label of the public URL: https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=freightaudit

LOG_LEVEL=info
